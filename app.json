{
  "expo": {
    "experiments": {
      "lazyBundling": true
    },
    "name": "Nudge",
    "slug": "nudge",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/63496dea-edf7-4461-bf1d-9bebb579438b"
    },
    "scheme": "nudge",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stonie24.nudge",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stonie24.nudge"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#5B8C1E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nudge uses your photo library to let you set a profile picture."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Nudge shows the events in your calendar next to your tasks. Your calendar stays on your device."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63496dea-edf7-4461-bf1d-9bebb579438b"
      }
    }
  }
}
